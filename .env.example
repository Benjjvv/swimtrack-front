# Entorno: development | production
FLASK_ENV=development

# Puerto del Flask front (convención del curso: 7001)
FLASK_RUN_PORT=7001

# Límite del upload de video completo (1 GiB por defecto).
MAX_CONTENT_LENGTH=1073741824

# Prefijo de URL. En local "/", en server "/swimtrack/"
URL_PREFIX=/

# URL base del Flask de IA (otro repo, otra persona). En local 7011.
IA_BASE_URL=http://localhost:7011

# Header secreto compartido con el Flask de IA. CAMBIAR por algo aleatorio.
IA_SECRET_HEADER=cambiame-por-algo-aleatorio-12345

# Servicio de visión RT-DETRv2 + ByteTrack en la red privada de la GPU. En desarrollo local usa http://127.0.0.1:8001.
VISION_BASE_URL=http://10.0.218.101:7001
# Debe coincidir exactamente con SWIMTRACK_AUTH_TOKEN en la máquina GPU.
VISION_AUTH_TOKEN=cambiame-por-otro-token-aleatorio
# Calibración normalizada del carril central para la cámara fija del proyecto.
VISION_LAP_CALIBRATION_ID=fixed-camera-v1

# El front envía batches HTTP; la primera versión infiere cada frame en forma secuencial.
VISION_BATCH_SIZE=8
VISION_INFERENCE_SIZE=640
VISION_JPEG_QUALITY=85

# Timeouts HTTP en segundos y retries idempotentes por batch.
VISION_CONNECT_TIMEOUT=5
VISION_READ_TIMEOUT=120
VISION_WRITE_TIMEOUT=30
VISION_POOL_TIMEOUT=5
VISION_CLEANUP_TIMEOUT=5
VISION_MAX_RETRIES=2
VISION_RETRY_BACKOFF_SECONDS=0.5
VISION_FALLBACK_FPS=30

# Clave de sesión de Flask. CAMBIAR en producción.
FLASK_SECRET_KEY=dev-secret-change-in-prod
