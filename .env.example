# Entorno: development | production
FLASK_ENV=development

# Puerto del Flask front (convención del curso: 7001)
FLASK_RUN_PORT=7001

# Prefijo de URL. En local "/", en server "/swimtrack/"
URL_PREFIX=/

# URL base del Flask de IA (otro repo, otra persona). En local 7011.
IA_BASE_URL=http://localhost:7011

# Header secreto compartido con el Flask de IA. CAMBIAR por algo aleatorio.
IA_SECRET_HEADER=cambiame-por-algo-aleatorio-12345

# Clave de sesión de Flask. CAMBIAR en producción.
FLASK_SECRET_KEY=dev-secret-change-in-prod
